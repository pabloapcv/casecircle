# Copy to web/.env on the machine that runs python3 serve.py.
# Never put these values in the browser, git, or screenshots.

# Required for a real language-model call. Leave unset to show "unavailable".
# CASECIRCLE_LLM_API_KEY=

# OpenAI-compatible Chat Completions root (no trailing slash).
# Default:
# CASECIRCLE_LLM_BASE_URL=https://api.openai.com/v1
# xAI:
# CASECIRCLE_LLM_BASE_URL=https://api.x.ai/v1

# Model id for that provider.
# Default:
# CASECIRCLE_LLM_MODEL=gpt-4o-mini
# xAI example:
# CASECIRCLE_LLM_MODEL=grok-2-latest

# Test-only. Serves clearly labeled mock replies. Do not use as a fake AI in production.
# CASECIRCLE_LLM_MOCK=1
